# OpenAI-compatible chat/tool-calling API (used by agent/, not by tools/ in Phase 1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Contact email sent to EBI Job Dispatcher (InterProScan) on each job submission.
# EBI requires this per their usage policy; it is not used for anything else.
EBI_CONTACT_EMAIL=you@example.com
