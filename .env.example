# LLM provider is pluggable -- any OpenAI-compatible chat/tool-calling API.
# Copy this file to .env and uncomment ONE provider block. Never commit .env
# (it is in .gitignore) and never print LLM_API_KEY in logs/traces/commits.

# --- Option A: Ollama (local, free, no API key) -- verified live in this project ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama

# --- Option B: DeepSeek (https://api-docs.deepseek.com) ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=sk-...

# --- Option C: Qwen via Alibaba Cloud Model Studio (DashScope OpenAI-compatible mode) ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-...

# Budget / safety limits (agent/loop.py enforces both; never bypassed)
MAX_STEPS=10
MAX_TOKENS_PER_RUN=100000

# Contact email sent to EBI Job Dispatcher (InterProScan) on each job submission.
# EBI requires this per their usage policy; it is not used for anything else.
EBI_CONTACT_EMAIL=you@example.com
